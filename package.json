{
  "name": "kisa-kes",
  "productName": "Kısa Kes",
  "description": "Videolardaki sessiz bölümleri otomatik kesen ve Premiere Pro XML'i üreten araç.",
  "author": "US3B3",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "mp4box": "0.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^7.3.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.kisakes.app",
    "productName": "Kısa Kes",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
