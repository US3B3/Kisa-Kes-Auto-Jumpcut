{
  "name": "kisa-kes",
  "productName": "Kısa Kes",
  "description": "Videolardaki sessiz bölümleri otomatik kesen ve Premiere Pro XML'i üreten araç.",
  "author": "US3B3",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\"",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "premiere:build": "vite build --mode premiere",
    "premiere:install": "npm run premiere:build && node scripts/install-premiere.cjs",
    "premiere:zxp": "npm run premiere:build && node scripts/build-zxp.cjs",
    "premiere:zip": "npm run premiere:build && cd premiere && rm -f ../release/Kisa-Kes-Premiere.zip && mkdir -p ../release && zip -qr ../release/Kisa-Kes-Premiere.zip CSXS jsx panel install"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "mp4box": "0.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^7.3.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.kisakes.app",
    "productName": "Kısa Kes",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Kisa-Kes-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "artifactName": "Kisa-Kes-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
